{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["node"],
    "strict": true,
    "noUnusedLocals": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true
  },
  "include": ["src", "vite.config.ts", "e2e/*.ts", "e2e/*.tsx", "e2e/features/*.tsx", "bench/*.ts", "bench/*.tsx", "tools/shots/*.ts", "tools/shots/*.tsx", ".claude/skills/verify-hermes-chat/scripts/*.ts"]
}
