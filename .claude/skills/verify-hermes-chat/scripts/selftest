#!/usr/bin/env bash
# Self-checks for the harness itself, not the app. Needs `hv bootstrap` done; no build, no app, no network.
#   wd.mjs: `wait` times out with exit 2, a bad [ms] is rejected, `gone` returns at once on no match.
#   hv up:  a failed start stops every process it started (and a child its driver left behind) and deletes its run dir;
#           an interrupted start (TERM) does the same;
#           three concurrent `hv up`s each get their own display (their own Xvfb holds its lock), and `hv down` stops them.
#           its private D-Bus activates nothing (no Secret Service with the owner's HOME) and runs with the run's HOME.
#   bridge: the stand-in survives a WebSocket closed or reset while it writes to it, and keeps serving.
# Runs under a throwaway HV_HOME with a fake app and a fake tauri-driver, so it never touches a real run.
set -euo pipefail

HERE=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
REAL_HOME=${HV_HOME:-$HOME/.cache/hermes-verify}
[ -d "$REAL_HOME/root" ] || command -v Xvfb >/dev/null || { echo "selftest: run \`hv bootstrap\` first" >&2; exit 1; }
T=$(mktemp -d)
FAILS=0
pass() { echo "ok   $*"; }
fail() { echo "FAIL $*"; FAILS=$((FAILS + 1)); }
dead() { local p; for p in "$@"; do [ -z "$p" ] || ! kill -0 "$p" 2>/dev/null || return 1; done; }
pids_of() { (. "$1"; echo "$XVFB_PID $WM_PID $DBUS_PID $BRIDGE_PID $DRIVER_PID"); }

# --- wd.mjs against a fake WebDriver that never finds anything ---
cat >"$T/fake-wd.mjs" <<'JS'
import { createServer } from "node:http";
const srv = createServer((req, res) => { res.setHeader("content-type", "application/json"); res.end(JSON.stringify({ value: [] })); });
srv.listen(0, "127.0.0.1", () => console.log(srv.address().port));
JS
node "$T/fake-wd.mjs" >"$T/fake-wd.port" &
FAKE_WD=$!
# `hv up`s still starting; cleanup stops them before it touches their run state.
LAUNCHERS=()
# Also stops any run an interrupted self-test left up.
cleanup() {
  local r p
  kill "$FAKE_WD" 2>/dev/null || true
  for p in "${LAUNCHERS[@]}"; do kill -TERM "$p" 2>/dev/null || true; done
  for p in "${LAUNCHERS[@]}"; do wait "$p" 2>/dev/null || true; done
  for r in "$T"/hv/runs/*/; do [ -f "$r/state.env" ] && HV_HOME=$T/hv HV_RUN=${r%/} "$HERE/hv" down >/dev/null 2>&1; done
  rm -rf "$T"
}
trap cleanup EXIT
trap 'exit 130' INT TERM
for _ in $(seq 50); do [ -s "$T/fake-wd.port" ] && break; sleep 0.1; done
mkdir -p "$T/wdrun"
printf "DRIVER_PORT='%s'\nEVIDENCE='%s'\n" "$(cat "$T/fake-wd.port")" "$T/wdrun" >"$T/wdrun/state.env"
echo fake-session >"$T/wdrun/session"
wd() { HV_RUN=$T/wdrun node "$HERE/wd.mjs" "$@"; }

start=$(date +%s%N); code=0; wd wait .nothing "" 400 >/dev/null 2>"$T/err" || code=$?
ms=$((($(date +%s%N) - start) / 1000000))
[ "$code" = 2 ] && grep -q "timed out after 400 ms" "$T/err" && [ "$ms" -lt 5000 ] && pass "wd wait times out with exit 2 (${ms} ms)" || fail "wd wait: exit $code after ${ms} ms: $(cat "$T/err")"
code=0; HV_RUN=$T/wdrun timeout 5 node "$HERE/wd.mjs" wait .nothing "" 5s >/dev/null 2>"$T/err" || code=$?
[ "$code" = 1 ] && grep -q "whole number of ms" "$T/err" && pass "wd wait rejects a non-numeric timeout" || fail "wd wait with ms=5s: exit $code: $(cat "$T/err")"
out=$(wd gone .nothing "" 400 2>&1) && [ "$out" = ok ] && pass "wd gone returns ok when nothing matches" || fail "wd gone: $out"

# --- hv up under a throwaway HV_HOME ---
export HV_HOME=$T/hv HV_TARGET=$T/target
mkdir -p "$HV_HOME" "$HV_TARGET/debug" "$T/bin"
[ -d "$REAL_HOME/root" ] && ln -s "$REAL_HOME/root" "$HV_HOME/root"
printf '#!/bin/sh\nexit 0\n' >"$HV_TARGET/debug/hermes-chat"; chmod +x "$HV_TARGET/debug/hermes-chat"
# A tauri-driver stand-in. FAKE_DRIVER=fail leaves a child running (as a WebKitWebDriver would), writes its PID to
# $FAKE_CHILD and exits at once; otherwise it answers 200 on --port.
cat >"$T/bin/tauri-driver" <<'SH'
#!/bin/sh
if [ "${FAKE_DRIVER:-}" = fail ]; then
  sleep 300 </dev/null >/dev/null 2>&1 &
  echo $! >"$FAKE_CHILD"
  echo "fake tauri-driver: failing on purpose" >&2
  exit 1
fi
exec python3 -c 'import sys, http.server as h
p = int(sys.argv[sys.argv.index("--port") + 1])
class Ok(h.BaseHTTPRequestHandler):
    def do_GET(self): self.send_response(200); self.end_headers(); self.wfile.write(b"{}")
    def log_message(self, *a): pass
h.HTTPServer(("127.0.0.1", p), Ok).serve_forever()' "$@"
SH
chmod +x "$T/bin/tauri-driver"
export PATH=$T/bin:$PATH
hv() { "$HERE/hv" "$@"; }

# A failed start leaves nothing running and no run dir, and keeps state.env with the evidence.
code=0; FAKE_DRIVER=fail FAKE_CHILD=$T/driver-child.pid hv up >"$T/up.log" 2>&1 || code=$?
st=$(ls "$HV_HOME"/evidence/*/state.env 2>/dev/null | head -1 || true)
if [ "$code" != 0 ] && [ -n "$st" ] && [ -s "$T/driver-child.pid" ] && [ -z "$(ls -A "$HV_HOME/runs")" ]; then
  # shellcheck disable=SC2046
  if dead $(pids_of "$st") "$(cat "$T/driver-child.pid")" && disp=$(. "$st"; echo "${DISPLAY_NUM#:}") && [ -n "$disp" ] && [ ! -e "/tmp/.X$disp-lock" ]; then
    pass "failed hv up stopped Xvfb :$disp, openbox, D-Bus, the stand-in, the driver and the child it left"
  else
    fail "failed hv up left processes or display :${disp:-?} behind ($(pids_of "$st"), driver child $(cat "$T/driver-child.pid" 2>/dev/null))"
  fi
else
  fail "failed hv up: exit $code, state ${st:-missing}, driver child pid $(cat "$T/driver-child.pid" 2>/dev/null || echo missing), runs: $(ls "$HV_HOME/runs"); log: $(tail -5 "$T/up.log")"
fi
rm -rf "$HV_HOME/evidence"

# A start interrupted with TERM, once Xvfb is up, stops what it started too.
"$HERE/hv" up >"$T/int.log" 2>&1 &
LAUNCHERS=($!)
for _ in $(seq 150); do
  st=$(ls "$HV_HOME"/runs/*/state.env 2>/dev/null | head -1 || true)
  [ -n "$st" ] && [ -n "$(. "$st"; echo "${WM_PID:-}")" ] && break
  sleep 0.1
done
kill -TERM "${LAUNCHERS[0]}"
code=0; wait "${LAUNCHERS[0]}" || code=$?
LAUNCHERS=()
st=$(ls "$HV_HOME"/evidence/*/state.env 2>/dev/null | head -1 || true)
# shellcheck disable=SC2046
if [ "$code" = 130 ] && [ -n "$st" ] && [ -z "$(ls -A "$HV_HOME/runs")" ] && dead $(pids_of "$st"); then
  pass "hv up interrupted with TERM stopped what it had started ($(pids_of "$st"))"
else
  fail "interrupted hv up: exit $code, state ${st:-missing}, pids $([ -n "$st" ] && pids_of "$st"), runs: $(ls "$HV_HOME/runs"); log: $(tail -3 "$T/int.log")"
fi
rm -rf "$HV_HOME/evidence"

# Concurrent starts get distinct displays, each held by its own Xvfb.
for i in 1 2 3; do "$HERE/hv" up >"$T/up$i.log" 2>&1 & LAUNCHERS+=($!); done
codes=()
for p in "${LAUNCHERS[@]}"; do code=0; wait "$p" || code=$?; codes+=("$code"); done
LAUNCHERS=()
runs=() displays=()
for i in 1 2 3; do
  r=$(sed -n 's/^export HV_RUN=//p' "$T/up$i.log")
  if [ "${codes[i-1]}" = 0 ] && [ -n "$r" ]; then runs+=("$r"); displays+=("$(. "$r/state.env"; echo "$DISPLAY_NUM")")
  else fail "concurrent hv up $i: exit ${codes[i-1]}: $(tail -5 "$T/up$i.log")"; fi
done
uniq_displays=$(printf '%s\n' "${displays[@]}" | sort -u | wc -l)
[ "${#runs[@]}" = 3 ] && [ "$uniq_displays" = 3 ] && pass "three concurrent hv up got displays ${displays[*]}" || fail "concurrent displays: ${displays[*]:-none}"
raced=$(cat "$HV_HOME"/evidence/*/xvfb.log | grep -c "trying display" || true)
echo "--   the three runs tried $raced displays to get 3 (more than 3 means a lost race was retried)"
# The private bus activates nothing: an app asking for the keyring with none running gets no daemon started for it,
# least of all one with the owner's HOME (#497).
if [ "${#runs[@]}" -gt 0 ]; then
  r=${runs[0]}
  bus=$(. "$r/state.env"; echo "$DBUS_ADDR") bus_pid=$(. "$r/state.env"; echo "$DBUS_PID")
  names=$(dbus-send --bus="$bus" --print-reply --dest=org.freedesktop.DBus /org/freedesktop/DBus org.freedesktop.DBus.ListActivatableNames 2>&1 | grep -o 'string "[^"]*"' | tr '\n' ' ')
  [ "$names" = 'string "org.freedesktop.DBus" ' ] && pass "the private D-Bus can activate nothing" || fail "the private D-Bus can activate: $names"
  start=$(dbus-send --bus="$bus" --print-reply --dest=org.freedesktop.DBus /org/freedesktop/DBus org.freedesktop.DBus.StartServiceByName string:org.freedesktop.secrets uint32:0 2>&1 || true)
  grep -q "ServiceUnknown" <<<"$start" && pass "asking it for a Secret Service starts none" || fail "StartServiceByName org.freedesktop.secrets: $start"
  bus_home=$(tr '\0' '\n' <"/proc/$bus_pid/environ" | sed -n 's/^HOME=//p')
  [ "$bus_home" = "$r/home" ] && pass "the private D-Bus runs with the run's HOME" || fail "the private D-Bus's HOME is ${bus_home:-unset}, not $r/home"
  # A WebSocket the app closes while the stand-in writes to it (EPIPE after a close, ECONNRESET after a reset) is
  # dropped, and the stand-in keeps serving (#432).
  cat >"$T/drop-ws.mjs" <<'JS'
import { connect } from "node:net";
const [port, how] = [process.argv[2], process.argv[3]];
const base = `http://127.0.0.1:${port}`;
const sock = connect(Number(port), "127.0.0.1");
sock.on("error", () => {});
let got = Buffer.alloc(0), stream;
const dropped = new Promise((resolve) => {
  sock.on("data", (d) => {
    got = Buffer.concat([got, d]);
    const head = got.indexOf("\r\n\r\n");
    if (head < 0) return;
    // Upgraded: start 100 frames, 5 ms apart, and drop the socket once the first one arrives.
    if (!stream) stream = fetch(`${base}/__changed?n=100&gap=5`, { method: "POST" });
    else if (got.length > head + 4) resolve(how === "reset" ? sock.resetAndDestroy() : sock.destroy());
  });
});
sock.write("GET /api/ws HTTP/1.1\r\nHost: 127.0.0.1\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\n\r\n");
sock.on("close", () => stream || (console.log("the stand-in refused the WebSocket"), process.exit(0)));
setTimeout(() => (console.log("no frame arrived to drop the socket on"), process.exit(0)), 10_000);
await dropped;
try {
  const [done, state] = [await stream, await fetch(`${base}/__state`)];
  console.log(done.status === 200 && state.status === 200 ? "ok" : `the stream answered ${done.status}, /__state ${state.status}`);
} catch (e) {
  console.log(`the stand-in stopped answering: ${e.cause?.code ?? e.message}`);
}
process.exit(0);
JS
  bridge_port=$(. "$r/state.env"; echo "$BRIDGE_PORT") bridge_pid=$(. "$r/state.env"; echo "$BRIDGE_PID")
  for how in close reset; do
    out=$(timeout 20 node "$T/drop-ws.mjs" "$bridge_port" "$how" 2>&1 || true)
    [ "$out" = ok ] && kill -0 "$bridge_pid" 2>/dev/null && pass "the stand-in keeps serving after the app ${how}s a WebSocket mid-write" ||
      fail "the stand-in after a WebSocket $how mid-write: ${out:-no output}; $(grep -m1 -E 'Error|WS closed' "$(. "$r/state.env"; echo "$EVIDENCE")/bridge.log")"
  done
  grep -q "WS closed by the app: EPIPE" "$(. "$r/state.env"; echo "$EVIDENCE")/bridge.log" && pass "the stand-in logged the EPIPE it dropped" ||
    echo "--   the stand-in logged no EPIPE this time (the close above met another error, or none)"
fi
for r in "${runs[@]}"; do
  # The doctor exits non-zero here anyway (fake driver, no build); only its Xvfb line matters.
  doc=$(HV_RUN=$r hv doctor 2>&1 || true)
  grep -q "^ok   Xvfb" <<<"$doc" && pass "doctor: $r's Xvfb is its own" || fail "doctor on $r: $(grep Xvfb <<<"$doc")"
  pids=$(pids_of "$r/state.env")
  HV_RUN=$r hv down >/dev/null 2>&1 || true
  # shellcheck disable=SC2086
  dead $pids && pass "hv down stopped $pids" || fail "hv down left some of $pids running"
done

[ "$FAILS" = 0 ] && echo "selftest: all ok" || { echo "selftest: $FAILS failed"; exit 1; }
