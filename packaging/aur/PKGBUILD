# Maintainer: l0cky12 <73147961+l0cky12@users.noreply.github.com>

pkgname=hermes-chat-git
_pkgname=hermes-chat
pkgver=r0
pkgrel=1
pkgdesc='Desktop chat client for a remote Hermes Agent'
arch=('x86_64')
url='https://github.com/l0cky12/hermes-chat'
license=('GPL-3.0-or-later')
depends=('webkit2gtk-4.1' 'gtk3' 'libsoup3' 'glib2' 'cairo' 'gdk-pixbuf2' 'dbus'
         'libgcc' 'glibc' 'hicolor-icon-theme')
makedepends=('git' 'cargo' 'npm')
optdepends=('openssh: sign in through an SSH tunnel'
            'org.freedesktop.secrets: remember the dashboard password'
            'slurp: pick a region or window for screenshots on Hyprland and Sway'
            'grim: take screenshots on Hyprland and Sway'
            'xdg-desktop-portal: take screenshots on GNOME and KDE Plasma'
            'desktop-file-utils: let other apps open hermes-chat:// chat links'
            'libayatana-appindicator: show the tray icon and use Close to tray'
            'hunspell-en_us: underline misspelled words as you write (or another language'"'"'s hunspell dictionary)')
provides=("$_pkgname")
conflicts=("$_pkgname")
# The -debug package makepkg splits off comes out empty for this build, so skip it.
# makepkg's lto option adds -flto to CFLAGS, so the C code in the ring crate is
# compiled to GCC LTO bytecode, which rust-lld (Rust's default linker) cannot read.
# The link then fails with undefined ring_core_* symbols.
options=('!debug' '!lto')
source=("$_pkgname::git+$url.git"
        "$_pkgname.desktop")
sha256sums=('SKIP'
            'e1bbcd9b872d66015782fe4afce508d0259c1c7521dd5f63bc6fc331cdba64ca')

pkgver() {
  cd "$_pkgname"
  printf 'r%s.%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

prepare() {
  cd "$_pkgname"
  export RUSTUP_TOOLCHAIN=stable
  npm ci --cache "$srcdir/npm-cache"
  cargo fetch --locked --manifest-path src-tauri/Cargo.toml \
    --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$_pkgname"
  export RUSTUP_TOOLCHAIN=stable
  # The Tauri CLI builds the frontend and adds the feature that embeds it in the binary.
  node_modules/.bin/tauri build --no-bundle -- --frozen
}

package() {
  cd "$_pkgname"
  install -Dm755 "src-tauri/target/release/$_pkgname" "$pkgdir/usr/bin/$_pkgname"
  # The launcher sets WEBKIT_DISABLE_DMABUF_RENDERER=1, as `npm run app` does.
  install -Dm644 "$srcdir/$_pkgname.desktop" "$pkgdir/usr/share/applications/$_pkgname.desktop"
  # The launcher's Icon=hermes-chat: every hicolor size tools/icons/build.sh renders (hinted below 64px, ADR 0049),
  # the master SVG, and a one-colour symbolic icon for high-contrast and symbolic themes.
  local size
  for size in 16 22 24 32 48 64 128 256 512; do
    install -Dm644 "src-tauri/icons/hicolor/${size}x${size}.png" \
      "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/$_pkgname.png"
  done
  install -Dm644 assets/icon.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/$_pkgname.svg"
  install -Dm644 assets/icons/hermes-chat-symbolic.svg \
    "$pkgdir/usr/share/icons/hicolor/symbolic/apps/$_pkgname-symbolic.svg"
}
