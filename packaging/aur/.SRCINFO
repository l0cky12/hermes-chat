pkgbase = hermes-chat-git
	pkgdesc = Desktop chat client for a remote Hermes Agent
	pkgver = r0
	pkgrel = 1
	url = https://github.com/l0cky12/hermes-chat
	arch = x86_64
	license = GPL-3.0-or-later
	makedepends = git
	makedepends = cargo
	makedepends = npm
	depends = webkit2gtk-4.1
	depends = gtk3
	depends = libsoup3
	depends = glib2
	depends = cairo
	depends = gdk-pixbuf2
	depends = dbus
	depends = libgcc
	depends = glibc
	depends = hicolor-icon-theme
	optdepends = openssh: sign in through an SSH tunnel
	optdepends = org.freedesktop.secrets: remember the dashboard password
	optdepends = slurp: pick a region or window for screenshots on Hyprland and Sway
	optdepends = grim: take screenshots on Hyprland and Sway
	optdepends = xdg-desktop-portal: take screenshots on GNOME and KDE Plasma
	optdepends = desktop-file-utils: let other apps open hermes-chat:// chat links
	optdepends = libayatana-appindicator: show the tray icon and use Close to tray
	optdepends = hunspell-en_us: underline misspelled words as you write (or another language's hunspell dictionary)
	provides = hermes-chat
	conflicts = hermes-chat
	options = !debug
	source = hermes-chat::git+https://github.com/l0cky12/hermes-chat.git
	source = hermes-chat.desktop
	sha256sums = SKIP
	sha256sums = e1bbcd9b872d66015782fe4afce508d0259c1c7521dd5f63bc6fc331cdba64ca

pkgname = hermes-chat-git
