{
  "name": "hermes-chat",
  "private": true,
  "version": "0.1.4",
  "description": "Desktop chat client for a remote Hermes Agent.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "app": "HERMES_CHAT_NEW_INSTANCE=1 WEBKIT_DISABLE_DMABUF_RENDERER=1 tauri dev",
    "dev": "vite",
    "build": "tsc --noEmit && tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json && npm run lint && vite build",
    "lint": "oxlint --deny-warnings",
    "test": "vitest run",
    "test:local": "vitest run --maxWorkers=2",
    "check": "node scripts/check-adrs.mjs && cargo fmt --manifest-path src-tauri/Cargo.toml --check && npm run build && npm run test:local && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "bump": "node scripts/release/version.mjs bump",
    "tauri": "tauri"
  },
  "dependencies": {
    "@novnc/novnc": "1.7.0",
    "@tauri-apps/api": "^2.12.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "hast-util-from-html-isomorphic": "^2.0.0",
    "hast-util-to-text": "^4.0.3",
    "highlight.js": "^11.12.0",
    "katex": "^0.18.11",
    "lucide-react": "^1.66.0",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-math": "^3.0.0",
    "mermaid": "^12.3.0",
    "micromark-extension-gfm": "^3.0.0",
    "micromark-extension-math": "^3.1.0",
    "micromark-util-decode-string": "^2.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "three": "0.186.1",
    "unist-util-visit": "^5.2.0",
    "vfile": "^6.0.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "oxlint": "1.90.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "typescript": "^7.0.2",
    "unified": "^11.0.5",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
